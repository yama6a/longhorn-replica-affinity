{
  // The schedule is the cron in .github/workflows/renovate.yaml, so workflow_dispatch works too.
  // Every automerged non-major bump cuts a release. Add minimumReleaseAge to slow that down.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>yama6a/gha:default.json5",
    "github>yama6a/gha:go.json5",
  ],

  // ci.yaml fails a PR without a release label. A dependency bump changes no flag, env or behaviour.
  labels: ["patch"],

  packageRules: [
    {
      // released together with cross-referenced types, so a partial bump does not compile
      description: "keep the kubernetes libraries in lockstep",
      matchPackageNames: ["k8s.io/api", "k8s.io/apimachinery", "k8s.io/client-go"],
      groupName: "kubernetes libraries",
    },
    {
      // Must match apimachinery's structured-merge-diff major, or go mod tidy breaks the build.
      // allowedVersions cannot hold it, because Renovate ships a pseudo-version bump as a digest update.
      // apimachinery's go.mod sets its floor, so gomodTidy moves it with each k8s.io bump.
      description: "kube-openapi follows apimachinery, never Renovate",
      matchPackageNames: ["k8s.io/kube-openapi"],
      enabled: false,
    },
  ],
}
